            "<MenuItem value='Новая'>Новая</MenuItem>",
            "<MenuItem value='В процессе обучения'>В процессе обучения</MenuItem>",
            "<MenuItem value='Обучение завершено'>Обучение завершено</MenuItem>",
            "</Select>",
            "</FormControl>",
            "",
            "<FormControl>",
