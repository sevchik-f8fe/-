        "body": [
            "import { query } from '../../../../lib/db';",
            "import { validateField } from '../../../../utils/utils';",
            "import crypto from 'crypto';",
            "export async function POST(request) {",
            "    try {",
            "        const body = await request.json();",
            "        const { login, fullname, password, email, phone } = body;",
            "        if (!validateField('login', login) || !validateField('fullname', fullname) || !validateField('password', password) || !validateField('email', email) || !validateField('phone', phone)) {",
            "            return Response.json({",
            "                success: false,",
            "            }, { status: 403 });",
            "        }",
            "        const salt = crypto.randomBytes(16).toString('hex');",
            "        const passwordHash = crypto.pbkdf2Sync(password, salt, 1000, 64, 'sha256').toString('hex');",
            "        const fullHash = `${salt}:${passwordHash}`;",
            "        const result = await query(",
            "            `insert into users (login, password_hash, fullname, phone, email, role)",
            "             values ($1, $2, $3, $4, $5, 'user')",
            "             returning id, login, fullname, phone, email, role, created_at",
            "            `,",
            "            [login, fullHash, fullname, phone, email]",
            "        );",
            "        const newUser = result.rows[0];",
            "        return Response.json({",
            "            success: true,",
            "            user: newUser,",
            "        }, { status: 201 })",
            "    } catch (e) {",
            "        return Response.json({",
            "            success: false,",
            "        }, { status: 500 });",
            "    }",
            "}",
        ]
