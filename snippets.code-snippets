            "/app/utils/utils.js"
        ],
        "body": [
            "           export const fieldIsValid = (field, value) => {",
            "    switch (field) {",
            "        case 'login': {",
            "            if (!/^[0-9a-zA-Z]{6,}/.test(value)) return false;",
            "            break;",
            "        } case 'password': {",
            "            if (value.length < 8) return false;",
            "            break;",
            "        } case 'email': {",
            "            if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(value)) return false;",
            "            break;",
            "        } case 'phone': {",
            "            if (!/^8\\(\\d{3}\\)\\d{3}-\\d{2}-\\d{2}$/.test(value)) return false;",
            "            break;",
            "        } case 'fullname': {",
            "            if (!/^[а-яА-Я\\s]{2,}$/.test(value)) return false",
            "            break;",
            "        }",
            "    }",
            "",
            "    return true;",
            "}",
        ]
    },
