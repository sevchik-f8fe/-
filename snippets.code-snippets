            "<InputLabel id='status-filter-id-l'>Статус</InputLabel>",
            "<Select labelId='status-filter-id-l' id='status-filter-id' value={filters.status} label='Статус' sx={{ minWidth: '10em' }} onChange={(e) => setFilters({ ...filters, status: e.target.value })}>",
