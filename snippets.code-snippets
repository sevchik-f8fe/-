            "    const [loading, setLoading] = useState(false);",
            "    const [review, setReview] = useState('');",
            "    const [tReview, setTReview] = useState('');",
            "",
            "    const handleClick = async (text, id) => {",
            "        if (text.trim().length == 0) {",
            "            alert('Заполните поле');",
            "            return;",
            "        } else {",
            "            setLoading(true);",
            "",
            "            await fetch('../../api/applications/feedback', {",
            "                method: 'POST',",
            "                headers: { 'Content-Type': 'application/json' },",
            "                body: JSON.stringify({ id, review: text.trim() })",
            "            })",
            "                .then((res) => res.json())",
            "                .then((res) => {",
            "                    if (res.success === true) {",
            "                        alert('Отзыв оставлен!')",
            "                        setReview(text.trim());",
            "                    } else {",
            "                        throw new Error;",
            "                    }",
            "                })",
            "                .catch(() => alert('Ошибка'))",
            "                .finally(() => setLoading(false))",
            "        }",
            "    }",
            "",
            "    return (",
            "        <Card sx={{ mb: 1, p: 2 }}>",
            "            <Typography variant='subtitle2' color='text.secondary'>",
            "                Заявка №{app.id}",
            "            </Typography>",
            "            <Typography variant='body1'>",
            "                <strong>Курс:</strong> {app.course}",
            "            </Typography>",
            "            <Typography variant='body2'>",
            "                <strong>Статус:</strong> {app.status}",
            "            </Typography>",
            "            <Typography variant='body2'>",
            "                <strong>Дата начала:</strong> {new Date(app.date_to_start).toLocaleDateString()}",
            "            </Typography>",
            "            {(app?.review?.length > 0 || review.length > 0) ? (",
            "                <Typography variant='body2'>",
            "                    <strong>Отзыв:</strong> {app.review || review}",
            "                </Typography>",
            "            ) : (",
            "                app.status == 'Обучение завершено' && (",
            "                    <Box sx={{ display: 'flex', gap: '1em', alignItems: 'center' }}>",
            "                        <TextField size='small' value={tReview} onChange={(e) => setTReview(e.target.value)} type='text' />",
