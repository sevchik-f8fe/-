        "body": [
            "            export const validateField = (field, value) => {",
            "    if (!value || value.length == 0) {",
            "        return false;",
            "    }",
            "    if (field == 'login' && (value.length < 6 || !/^[a-zA-Z0-9]+$/.test(value)) && value !== process.env.ADLOGIN) return false;",
            "    if (field == 'password' && (value.length < 8 || /[`;<>]/.test(value)) && value !== process.env.ADPASS) return false;",
            "if (field == 'phone' && !/^8\\(\\d{3}\\)\\d{3}-\\d{2}-\\d{2}$/.test(value)) return false;",
            "if (field == 'fullname' && !/^[а-яА-ЯёЁ\\s]+$/.test(value)) return false;",
            "if (field == 'email' && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(value)) return false;",
            "    if (field == 'payment' && (value !== 'наличными' && value !== 'переводом по номеру телефона')) return false;",
            "    if (field == 'curse' && (value !== 'Основы веб-дизайна' && value !== 'Основы проектирования баз данных' && value !== 'Основы алгоритмизации и программирования')) return false;",
            "  if (field == 'dateToStart' && (new Date(value) < Date.now() || isNaN(new Date(value).getTime()))) return false;",
            "    return true;",
            "}",
        ]
    },
