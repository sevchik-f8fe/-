            "const [hasMore, setHasMore] = useState(true);",
            "",
            "const router = useRouter();",
            "",
            "const loadMore = async (page, filters) => {",
            "setLoading(true);",
            "",
            "await fetch('../../api/users', {",
            "method: 'POST',",
            "headers: { 'Content-Type': 'application/json' },",
            "body: JSON.stringify({ page, filters })",
            "})",
            ".then((res) => res.json())",
            ".then((res) => {",
            "if (res.success === true) {",
            "console.log(res)",
            "setApps(res.apps);",
            "setHasMore(res.hasMore);",
            "} else {",
            "throw new Error;",
            "}",
            "})",
            ".catch(() => alert('Ошибка'))",
            ".finally(() => setLoading(false))",
            "}",
            "",
            "useEffect(() => {",
            "console.log(user)",
            "if (user?.role != 'admin') router.push('/pages/signin');",
            "else {",
            "loadMore(1, { pay: '', status: '' })",
            "}",
            "}, [])",
            "",
            "useEffect(() => {",
            "if (!loading) {",
            "loadMore(page, filters)",
            "}",
            "}, [page])",
            "",
            "const handleClick = async (filters) => {",
            "if (!loading) {",
            "loadMore(1, filters)",
            "}",
            "};",
            "",
            "return (",
            "<main>",
            "<Box className='container' sx={{ display: 'flex', flexDirection: 'row', flexWrap: 'wrap', alignItems: 'center', gap: '1em' }}>",
