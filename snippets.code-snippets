        "body": [
            "import { query } from '../../../utils/db';",
            "import { fieldIsValid } from '../../../utils/utils';",
            "import crypto from 'crypto';",
            "",
            "export async function POST(request) {",
            "try {",
            "const body = await request.json();",
            "const { fullname, login, password, email, phone } = body;",
            "",
            "if (!fieldIsValid('fullname', fullname) || !fieldIsValid('login', login) || !fieldIsValid('password', password) || !fieldIsValid('email', email) || !fieldIsValid('phone', phone)) {",
            "return Response.json({ success: false }, { status: 403 })",
            "}",
            "",
            "const exUser = await query(`select id from users where login=$1 or email=$2 or phone=$3`, [login, email, phone]);",
            "",
            "if (exUser.rows.length > 0) {",
            "return Response.json({ success: false }, { status: 403 })",
            "}",
            "",
            "const salt = crypto.randomBytes(16).toString('hex');",
            "const password_hash = crypto.pbkdf2Sync(password, salt, 1000, 64, 'sha256').toString('hex');",
            "const hash = `${salt}:${password_hash}`;",
            "",
            "const res = await query(",
            "`insert into users (login, password_hash, email, phone, fullname)",
            "values ($1, $2, $3, $4, $5)",
            "returning id, role`, [login, hash, email, phone, fullname]",
            ");",
            "",
            "const user = res.rows[0];",
            "",
            "return Response.json({ success: true, user }, { status: 201 })",
            "} catch (e) {",
            "console.log(e)",
            " return Response.json({ success: false }, { status: 500 })",
            "}",
            "}",
        ]
    },
    "/app/api/users/route.js": {
        "prefix": [
            "/app/api/users/route.js"
        ],
        "body": [
            "import { query } from '../../utils/db';",
            "",
            "export async function POST(request) {",
            "try {",
            "const body = await request.json();",
            "const { page = 1, filters = { pay: '', status: '' } } = body;",
            "",
            "const offset = (page - 1) * 10;",
            "",
            "let req = '';",
            "let params = [];",
            "",
            "if (filters.pay.length > 0) params.push(`a.pay='${filters.pay}'`);",
            "if (filters.status.length > 0) params.push(`a.status='${filters.status}'`);",
            "",
            "if (params.length > 0) {",
            "req = 'where ';",
            "if (params.length > 1) {",
            "req += params.join(' and ');",
            "} else {",
            "req += params[0]",
            "}",
            "}",
            "",
            "const res = await query(`",
            "select a.id, a.course, a.pay, a.date_to_start, a.status, a.review,",
            "u.fullname, u.email, u.phone, u.login",
            "from applications a join users u on a.user_id=u.id",
            "${req}",
            "order by a.id desc limit 10 offset ${offset}",
            "`);",
            "",
            "const count = await query(`select count(*) from applications a join users u on a.user_id=u.id ${req}`);",
            "",
            "return Response.json({ success: true, apps: res.rows, hasMore: count.rows[0].count > (10 * page) }, { status: 201 })",
            "} catch (e) {",
            "console.log(e)",
            "return Response.json({ success: false }, { status: 500 });",
            "}",
            "}",
        ]
    },
