            "            alert('Введите корректный номер телефона');",
            "            return false;",
            "        }",
            "        if (!formData.email.includes('@')) {",
            "            alert('Введите корректный email');",
            "            return false;",
            "        }",
            "        return true",
            "    }",
            "    const createUser = async () => {",
            "        if (!validateFields()) return;",
            "        setLoading(true);",
            "        try {",
            "            const res = await fetch('api/auth/register', {",
            "                method: 'POST',",
            "                headers: { 'Content-Type': 'application/json;charset=utf-8' },",
            "                body: JSON.stringify({",
            "                    login: formData.login.trim(),",
            "                    password: formData.password.trim(),",
            "                    email: formData.email.trim(),",
            "                    phone: formData.phone.trim(),",
            "                    fullname: formData.fullname.trim()",
            "                })",
            "            });",
            "            const data = await res.json();",
            "            if (data.success === true) {",
            "                saveData('user', data.user);",
            "                router.push('/');",
            "            } else {",
            "                throw new Error();",
            "            }",
            "        } catch (e) {",
            "            alert('Ошибка.');",
            "        } finally {",
            "            setLoading(false);",
            "        }",
            "    }",
            "    const formatPhone = (inputValue) => {",
            "        let digits = inputValue.replace(/\\D/g, '').slice(0, 11);",
            "        if (!digits.startsWith('8') && digits.length > 0) {",
            "            digits = '8' + digits.slice(0, 10);",
            "        } else if (digits.length === 0) {",
            "            digits = '8';",
            "        }",
            "        let result = digits[0] || '';",
            "        if (digits.length > 1) result += '(' + digits.slice(1, 4);",
            "        if (digits.length > 4) result += ')' + digits.slice(4, 7);",
            "        if (digits.length > 7) result += '-' + digits.slice(7, 9);",
            "        if (digits.length > 9) result += '-' + digits.slice(9, 11);",
            "        return result;",
            "    };",
            "    const handleChangePhone = (e) => {",
            "        const formatted = formatPhone(e.target.value);",
            "        setFormData({ ...formData, phone: formatted });",
            "    };",
            "    const fields = [",
            "        { id: 'login', label: 'логин: латиница/цифры, мин - 6 символов', type: 'text', value: formData.login, onchange: (e) => setFormData({ ...formData, login: e.target.value.replace(/[^a-zA-Z0-9]/g, '') }) },",
            "        { id: 'password', label: 'пароль: мин - 8 символов', type: 'password', value: formData.password, onchange: (e) => setFormData({ ...formData, password: e.target.value }) },",
            "        { id: 'fullname', label: 'ФИО: кириллица/пробелы', type: 'text', value: formData.fullname, onchange: (e) => setFormData({ ...formData, fullname: e.target.value.replace(/[^а-яА-ЯёЁ\\s]/g, '') }) },",
