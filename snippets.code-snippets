        "body": [
            "'use client';",
            "",
            "import { useEffect, useState } from 'react';",
            "import { useUser } from '../../utils/UserContext';",
            "import { useRouter } from 'next/navigation';",
            "import { FormControl, Paper, InputLabel, Select, MenuItem, Button, Box, Typography, Link, TableContainer, Table, TableHead, TableRow, TableCell, TableBody, Chip } from '@mui/material';",
            "",
            "const Admin = () => {",
            "const { user } = useUser();",
            "const [filters, setFilters] = useState({ pay: '', status: '' });",
            "const [loading, setLoading] = useState(false);",
            "const [page, setPage] = useState(1)",
