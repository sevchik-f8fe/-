    "select with filters": {
        "prefix": [
            "swp"
        ],
        "body": [
            "    import { query } from '../../../lib/db';",
            "import { validateField } from '../../../utils/utils';",
            "export async function POST(request) {",
            "    try {",
            "        const body = await request.json();",
            "        const { page = 1, filters = { payment: '', status: '' } } = body;",
            "        if ((!validateField('payment', filters.payment) && filters.payment.trim().length > 0) || (!validateField('status', filters.status) && filters.status.trim().length > 0)) {",
            "            return Response.json({",
            "                success: false,",
            "            }, { status: 403 });",
            "        }",
            "        const limit = 10;",
            "        const offset = (page - 1) * limit",
            "        let clause = '';",
            "        let params = [];",
            "        let ebalvrot = '';",
            "        if (filters.payment?.trim()?.length > 0) params.push(`a.payment='${filters.payment.trim()}'`);",
            "        if (filters.status?.trim()?.length > 0) params.push(`a.status='${filters.status.trim()}'`);",
            "        if (params.length > 0) {",
            "            clause = 'where ';",
            "            if (params.length > 1) {",
            "                ebalvrot = params.join(' and ');",
            "            } else {",
            "                ebalvrot = params[0];",
            "            }",
            "            clause += ebalvrot;",
            "        }",
            "        const apps = await query(`select ",
            "    a.id, a.user_id, a.course, a.payment, a.datetostart, a.status, a.created_at, ",
            "    u.role, u.fullname, u.email, u.phone, u.login",
            "    from applications a join users u on a.user_id=u.id",
            "    ${clause}",
            "    order by a.id desc limit ${limit} offset ${offset}",
            "    `);",
            "        const count = await query(`select count(*) from applications`)",
            "        return Response.json({",
            "            success: true,",
            "            apps: apps.rows,",
            "            hasMore: count.rows[0].count > (limit * page),",
            "        }, { status: 201 })",
            "    } catch (e) {",
            "        return Response.json({",
            "            success: false,",
            "        }, { status: 500 });",
            "    }",
            "}",
        ]
    },
