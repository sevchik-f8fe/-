    "/app/api/auth/signin/route.js": {
        "prefix": [
            "/app/api/auth/signin/route.js"
        ],
        "body": [
            "import { query } from '../../../utils/db';",
            "import { fieldIsValid } from '../../../utils/utils';",
            "import crypto from 'crypto';",
            "",
            "export async function POST(request) {",
            "try {",
            "const body = await request.json();",
            "const { login, password } = body;",
            "",
            "if (login !== 'admin' && (!fieldIsValid('login', login) || !fieldIsValid('password', password))) {",
            "return Response.json({ success: false }, { status: 403 })",
            "}",
            "",
            "const ex = await query(`select id, role, password_hash from users where login=$1`, [login]);",
            "",
            "if (ex.rows.length == 0) {",
            "return Response.json({ success: false }, { status: 403 });",
            "}",
            "",
            "const user = ex.rows[0];",
            "",
            "const [salt, hash] = user.password_hash.split(':');",
            "const userHash = crypto.pbkdf2Sync(password, salt, 1000, 64, 'sha256').toString('hex');",
            "",
            "if (hash !== userHash) {",
            "Response.json({ success: false }, { status: 403 });",
            "}",
            "",
            "const cleanUser = { role: user.role, id: user.id };",
            "return Response.json({ success: true, user: cleanUser }, { status: 201 })",
            "} catch (e) {",
            "console.log(e)",
            "return Response.json({ success: false }, { status: 500 })",
            "}",
            "}",
        ]
    },
    "/app/api/auth/signup/route.js": {
