            "id='pay-filter-id'",
            "value={filters.pay}",
            "sx={{ minWidth: '10em' }}",
            "label='Способ оплаты'",
            "onChange={(e) => setFilters({ ...filters, pay: e.target.value })}",
            ">",
            "<MenuItem value=''>По умолчанию</MenuItem>",
            "<MenuItem value='Наличными'>Наличными</MenuItem>",
            "<MenuItem value='Переводом по номеру телефона'>Переводом по номеру телефона</MenuItem>",
            "</Select>",
            "</FormControl>",
            "",
            "<Button variant='contained' size='small' loading={loading} disabled={loading} onClick={() => handleClick(filters)}>Поиск</Button>",
